{
  "name": "octopad",
  "version": "29.3.0",
  "description": "Connect Octopad and load its skills for work, knowledge, documentation, the CRM and Octoplan, under the methodology served by the server.",
  "author": {
    "name": "Sudolab"
  },
  "homepage": "https://octopad.ai",
  "repository": "https://github.com/sudolab-co/octopad-plugin",
  "license": "MIT",
  "keywords": [
    "octopad",
    "knowledge",
    "documentation",
    "planning",
    "crm"
  ],
  "mcpServers": "./.mcp.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/claude-session/claude-session.sh\" hook; exit 0",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:octopad:octopad",
            "tool": "turn_reminder",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__Claude_Browser__navigate|mcp__Claude_Browser__preview_start|mcp__Claude_Browser__browser_batch",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/desktop-pane/desktop-pane.sh\"; exit 0",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
