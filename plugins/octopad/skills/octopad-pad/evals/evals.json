{
  "skill_name": "octopad-pad",
  "protocol": {
    "status": "run 2026-11-10 on 24.0.0 and 25.0.0 (80 agent runs), then reruns of 15 and 6 runs on the fixed skill; a check of the review fixes (12 runs) is prepared, its first attempt stopped on a stub defect",
    "purpose": "Compare plugin 24.0.0 (no octopad-pad) with 25.0.0 on routing and on the observable Pad writes; static checks do not establish AI behavior.",
    "execution": "claude plugin eval on the Claude Code subscription, after the operator approves the protocol. Every Octopad tool is a mock answering fictional fixtures: nothing reaches an Octopad organization.",
    "comparison": "The behaviour and correction cases run on both versions; the trigger cases on 25.0.0 only, since 24.0.0 holds no octopad-pad. Defeat proof: the correction cases on 25.0.0 with the section \"Route a correction\" removed must fail at least one of them.",
    "release_limit": "Unrun cases are not a routing, behavioral or non-regression pass."
  },
  "evals": [
    {
      "id": "due-update",
      "prompt": "Good morning. Let us get going in Octopad, workspace Example.",
      "must_load": true,
      "kind": "behaviour",
      "versions": [
        "24.0.0",
        "25.0.0"
      ],
      "context": "Smart Brief and Brand watch due; Marketing ideas not due. The Smart Brief has news in Atlas launch and Billing, none in Hiring, a validation placed in Atlas launch and an answer request Outside focus; Brand watch has nothing new. One owned goal waits for a status line.",
      "expected_behavior": [
        "The run opens octopad-pad and records it with skill_opened.",
        "Every save of an existing tab carries expected_revision.",
        "pad context is called exactly once.",
        "The context call names no tab.",
        "The Smart Brief is saved once, with its own through as given.",
        "Brand watch is saved once, with its own through.",
        "Brand watch, where nothing changed, is saved without content.",
        "Marketing ideas, which is not due, is never saved.",
        "No save writes Outside focus or its vendor request.",
        "The quiet Hiring theme gets no section.",
        "No saved text repeats a task title.",
        "The Smart Brief marks the migration unblocked, with its task in refs.",
        "Objects go in refs, never as inline ref: links.",
        "Goal upkeep starts only after a Pad save.",
        "The owned goal to refresh gets set_status with base_revision 3.",
        "In the pad save call for tab smart_brief, content.lead has at most two sentences. The first says what changed since Nov 8 (such as the migration being unblocked or EU payment retries being fixed). The second says what to do first, putting the pricing review due Nov 10, which others wait on, or the now-ready migration first. FAIL if there is no lead, if it has more than two sentences, or if it does not say what to do first."
      ],
      "graders": [
        {
          "name": "opens-octopad-pad",
          "type": "tool_used",
          "tool": "mcp__plugin_octopad_octopad__skill_opened",
          "input_match": "\"skill\":\\s*\"octopad-pad\"",
          "min": 1
        },
        {
          "name": "every-save-carries-its-revision",
          "type": "tool_used",
          "tool": "mcp__plugin_octopad_octopad__pad",
          "input_match": "^(?=[\\s\\S]*\"action\":\\s*\"save\")(?=[\\s\\S]*\"tab\")(?![\\s\\S]*\"expected_revision\")",
          "min": 0,
          "max": 0
